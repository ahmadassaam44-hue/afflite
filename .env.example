# ============================================================
# Afflite — قائمة المفاتيح السرية (قيم وهمية فقط)
# ============================================================
# هذا الملف توثيق فقط ولا يُقرأ مباشرة من التطبيق.
# القيم الحقيقية توضع في secrets.php (مستثنى في .gitignore)
# ولا تُرفع أبداً إلى Git.
# انسخ كل سطر تحتاجه إلى secrets.php بصيغة:
#   define('ADMIN_PASS', 'القيمة-الحقيقية');
# ============================================================

# حساب الإدارة
ADMIN_EMAIL=admin@example.com
ADMIN_PASS=CHANGE_ME

# Supabase
SB_KEY=CHANGE_ME
SB_SERVICE=CHANGE_ME
USE_SUPABASE=false

# واجهة Hevo
HEVO_API_KEY=CHANGE_ME

# إرسال الإيميل عبر Supabase Edge Function (send-mail)
MAIL_FN_URL=https://CHANGE_ME.supabase.co/functions/v1/send-mail
MAIL_FN_SECRET=CHANGE_ME

# تنبيهات تليجرام للإدارة (اختياري)
TG_BOT_TOKEN=CHANGE_ME
TG_CHAT_ID=CHANGE_ME

# تسجيل الدخول بجوجل (true بعد ضبط بيانات جوجل في Supabase)
GOOGLE_LOGIN_ON=false
